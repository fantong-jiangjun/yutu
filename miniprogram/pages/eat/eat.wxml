<view class="eat-page">
  <view class="eat-banner">转一下，今天吃哪家 · 数据保存在本机</view>

  <view class="wheel-picker" bindtap="openWheelPicker">
    <text class="picker-label">当前转盘</text>
    <view class="picker-value">
      <text class="picker-name">{{wheelName}}</text>
      <text class="picker-count">{{itemCount}} 个选项 · 盘面数字对应下方列表</text>
    </view>
    <text class="picker-arrow">切换 ›</text>
  </view>

  <view class="wheel-area" style="width: {{wheelSize}}rpx; height: {{wheelSize}}rpx;">
    <view class="wheel-pointer"></view>
    <view
      class="wheel-rotor {{spinning ? 'is-spinning' : ''}}"
      style="width: {{wheelSize}}rpx; height: {{wheelSize}}rpx; transform: rotate({{rotation}}deg);"
    >
      <view class="wheel-disc" style="width: {{wheelSize}}rpx; height: {{wheelSize}}rpx;">
        <view
          class="wheel-slice"
          wx:for="{{slices}}"
          wx:key="index"
          style="transform: rotate({{item.rotate}}deg);"
        >
          <view
            class="slice-fill"
            style="background: {{item.color}}; transform: skewY({{item.skewNeg}}deg);"
          >
            <view
              class="slice-label-wrap"
              style="top: {{labelTop}}%; transform: skewY({{item.skewInner}}deg) rotate({{item.textRotate}}deg);"
            >
              <text class="slice-num" style="font-size: {{fontSize}}rpx;">{{item.num}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view class="wheel-center">
      <text class="wheel-center-text">吃</text>
    </view>
    <view class="wheel-ring" style="width: {{wheelSize}}rpx; height: {{wheelSize}}rpx;"></view>
  </view>

  <view class="result-box" wx:if="{{resultName}}">
    <view class="result-label">今天就吃</view>
    <view class="result-name">{{resultName}}</view>
    <view class="result-num" wx:if="{{resultNum}}">第 {{resultNum}} 号</view>
  </view>

  <button class="spin-btn" bindtap="onSpin" disabled="{{spinning || itemCount < 2}}">
    {{spinning ? '转盘中…' : '开始转'}}
  </button>

  <view class="action-row">
    <button class="action-btn" bindtap="goManage">管理转盘</button>
    <button class="action-btn action-primary" bindtap="goEdit">编辑选项</button>
  </view>

  <view class="tag-panel" wx:if="{{items.length}}">
    <view class="tag-title">全部 {{itemCount}} 个选项</view>
    <view class="tag-list">
      <text class="tag-item" wx:for="{{items}}" wx:key="*this" wx:for-index="idx">{{idx + 1}}. {{item}}</text>
    </view>
  </view>

  <ad-banner />
</view>
