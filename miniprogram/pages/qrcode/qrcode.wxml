<view class="tool-page">
  <view class="tool-banner">
    <text>🔒</text>
    <text>粘贴网址或链接，本地生成二维码，扫码打开网页</text>
  </view>

  <view class="tool-card" style="padding: 28rpx;">
    <view style="font-size: 28rpx; font-weight: 600; color: #1e3a8a; margin-bottom: 16rpx;">输入网址或链接</view>
    <textarea
      class="text-input"
      placeholder="粘贴 http 或 https 开头的链接"
      value="{{url}}"
      bindinput="onInput"
      maxlength="500"
      show-confirm-bar="{{false}}"
    />
    <view class="pick-hint">已输入 {{url.length}} / 500 字</view>
    <button class="pick-btn" style="margin-top: 24rpx;" bindtap="onGenerate" disabled="{{generating}}">
      {{generating ? '生成中...' : '生成二维码'}}
    </button>
  </view>

  <view class="tool-card" style="padding: 28rpx;" wx:if="{{showResult}}">
    <view class="preview-box">
      <view class="qr-canvas-wrap">
        <image wx:if="{{qrPath}}" class="qr-preview" src="{{qrPath}}" mode="aspectFit" />
        <view wx:else class="qr-placeholder">生成中...</view>
      </view>
    </view>
    <button class="pick-btn" style="margin-top: 24rpx;" bindtap="saveQR" disabled="{{!qrPath}}">保存到相册</button>
    <button class="secondary-btn" bindtap="copyUrl" wx:if="{{url}}">复制链接</button>
  </view>

  <view class="foot-note">
    <view class="foot-note-item">· 仅支持 http / https 链接，扫码可直接打开网页</view>
    <view class="foot-note-item">· 全部在手机本地生成，不上传服务器</view>
  </view>

  <canvas type="2d" id="qrExportCanvas" class="hidden-canvas" style="width:800px;height:800px;" />

  <ad-banner />
</view>
