@import "../../styles/tool-page.wxss";

.qr-preview {
  width: 520rpx;
  height: 520rpx;
  display: block;
}

.qr-placeholder {
  width: 520rpx;
  height: 520rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #94a3b8;
}

.hidden-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 1px;
  height: 1px;
}
