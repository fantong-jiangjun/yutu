<view class="container">
  <view class="privacy-banner">
    <text>🔒 本地转换，多张图片合成一个 PDF，不上传服务器</text>
  </view>

  <view class="card">
    <view class="card-title">选择图片</view>
    <view class="pick-btns">
      <button class="pick-btn" bindtap="chooseImages">{{images.length ? '继续添加' : '从相册选择'}}</button>
      <button class="pick-btn pick-btn-clear" wx:if="{{images.length}}" bindtap="clearImages">清空</button>
    </view>
  </view>

  <view class="card" wx:if="{{images.length}}">
    <view class="card-title">已选 {{images.length}} 张</view>
    <view class="img-list">
      <view class="img-item" wx:for="{{images}}" wx:key="*this">
        <image class="thumb" src="{{item}}" mode="aspectFill" />
        <view class="img-remove" data-index="{{index}}" bindtap="removeImage">删除</view>
      </view>
    </view>
    <view class="reorder-hint">按选择顺序合成 PDF，如需调整顺序请清空后重选</view>
  </view>

  <button
    class="btn-primary"
    bindtap="onConvert"
    disabled="{{!images.length || converting}}"
  >
    {{converting ? '转换中...' : '合成 PDF（' + images.length + ' 张）'}}
  </button>

  <view class="card result-card" wx:if="{{pdfPath}}">
    <view class="card-title">转换完成</view>
    <view class="result-text">已将 {{images.length}} 张图片合成一个 PDF</view>
    <button class="btn-primary" bindtap="openPdf">打开预览</button>
    <button class="share-btn" bindtap="sharePdf">分享 PDF 文件</button>
  </view>

  <view class="foot-note">
    <view class="foot-note-title">说明</view>
    <view class="foot-note-item">· 微信相册每次最多选 9 张，这是系统限制</view>
    <view class="foot-note-item">· 可多次点「继续添加」，总张数不限</view>
    <view class="foot-note-item">· 全部本地处理，不上传服务器</view>
  </view>

  <canvas type="2d" id="pdfCanvas" class="hidden-canvas" style="width:800px;height:800px;" />

  <ad-banner />
</view>
