.eat-page {
  min-height: 100vh;
  padding: 24rpx 32rpx 48rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #fff7ed 0%, #fffbf5 50%, #fef3c7 100%);
}

.eat-banner {
  font-size: 24rpx;
  color: #9a3412;
  background: rgba(255, 255, 255, 0.75);
  border: 1rpx solid #fed7aa;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  line-height: 1.5;
}

.wheel-picker {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 28rpx;
  border: 1rpx solid #fed7aa;
  box-shadow: 0 4rpx 16rpx rgba(234, 88, 12, 0.08);
}

.picker-label {
  font-size: 24rpx;
  color: #94a3b8;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.picker-value {
  flex: 1;
  min-width: 0;
}

.picker-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #9a3412;
}

.picker-count {
  display: block;
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 4rpx;
}

.picker-arrow {
  font-size: 26rpx;
  color: #fb923c;
  flex-shrink: 0;
}

.wheel-area {
  position: relative;
  margin: 0 auto 32rpx;
}

.wheel-pointer {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 20rpx solid transparent;
  border-right: 20rpx solid transparent;
  border-top: 40rpx solid #ea580c;
  z-index: 20;
  filter: drop-shadow(0 4rpx 8rpx rgba(234, 88, 12, 0.4));
}

.wheel-rotor {
  position: relative;
  z-index: 2;
  transition: none;
}

.wheel-rotor.is-spinning {
  transition: transform 4.5s cubic-bezier(0.12, 0.8, 0.12, 1);
}

.wheel-disc {
  border-radius: 50%;
  overflow: hidden;
  position: relative;
  background: #fff;
  box-shadow: 0 8rpx 32rpx rgba(234, 88, 12, 0.18);
}

.wheel-ring {
  position: absolute;
  top: 0;
  left: 0;
  border-radius: 50%;
  border: 6rpx solid #fff;
  box-sizing: border-box;
  pointer-events: none;
  z-index: 5;
  box-shadow: inset 0 0 0 2rpx rgba(234, 88, 12, 0.15);
}

.wheel-slice {
  position: absolute;
  left: 50%;
  top: 0;
  width: 50%;
  height: 50%;
  transform-origin: 0 100%;
  overflow: hidden;
}

.slice-fill {
  width: 100%;
  height: 100%;
  transform-origin: 0 100%;
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  box-sizing: border-box;
}

.slice-label-wrap {
  position: absolute;
  left: 0;
  width: 100%;
  transform-origin: 50% 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  pointer-events: none;
}

.slice-num {
  color: #fff;
  font-weight: 700;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.35);
  line-height: 1;
}

.result-num {
  font-size: 24rpx;
  color: #94a3b8;
  margin-top: 8rpx;
}

.wheel-center {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 88rpx;
  height: 88rpx;
  margin: -44rpx 0 0 -44rpx;
  border-radius: 50%;
  background: #fff;
  border: 4rpx solid #fed7aa;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 15;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  pointer-events: none;
}

.wheel-center-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #ea580c;
}

.result-box {
  text-align: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid #fb923c;
}

.result-label {
  font-size: 24rpx;
  color: #94a3b8;
  margin-bottom: 8rpx;
}

.result-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #ea580c;
}

.spin-btn {
  background: linear-gradient(135deg, #fb923c, #ea580c);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 16rpx;
  padding: 26rpx 0;
  border: none;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(234, 88, 12, 0.3);
}

.spin-btn[disabled] {
  background: #cbd5e1;
  box-shadow: none;
}

.action-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.action-btn {
  flex: 1;
  background: #fff;
  color: #9a3412;
  border: 1rpx solid #fdba74;
  border-radius: 14rpx;
  font-size: 26rpx;
  padding: 20rpx 0;
}

.action-primary {
  background: #fff7ed;
  color: #ea580c;
  font-weight: 500;
}

.tag-panel {
  background: rgba(255, 255, 255, 0.85);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid #fed7aa;
}

.tag-title {
  font-size: 24rpx;
  color: #94a3b8;
  margin-bottom: 16rpx;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag-item {
  font-size: 22rpx;
  color: #9a3412;
  background: #ffedd5;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
}

.manage-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.manage-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  border: 1rpx solid #fed7aa;
}

.manage-main {
  flex: 1;
  min-width: 0;
}

.manage-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #334155;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.manage-desc {
  font-size: 24rpx;
  color: #94a3b8;
  margin-top: 6rpx;
}

.manage-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.edit-link {
  font-size: 26rpx;
  color: #ea580c;
  padding: 8rpx 16rpx;
}
