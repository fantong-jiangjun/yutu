.tool-page {
  min-height: 100vh;
  padding: 24rpx 32rpx 48rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #dbeafe 0%, #eff6ff 35%, #f0f9ff 100%);
}

.tool-banner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(255, 255, 255, 0.85);
  border: 2rpx solid #bfdbfe;
  border-radius: 999rpx;
  padding: 16rpx 28rpx;
  font-size: 24rpx;
  color: #1d4ed8;
  margin-bottom: 24rpx;
}

.tool-card {
  border-radius: 28rpx;
  border: 2rpx solid #bfdbfe;
  box-shadow: 0 8rpx 32rpx rgba(37, 99, 235, 0.1);
  background: rgba(255, 255, 255, 0.92);
  margin-bottom: 24rpx;
}

.pick-btn {
  flex: 1;
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  color: #fff;
  font-size: 28rpx;
  border-radius: 16rpx;
  border: none;
}

.pick-btns {
  display: flex;
  gap: 16rpx;
}

.pick-hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.6;
}

.text-input {
  width: 100%;
  min-height: 160rpx;
  box-sizing: border-box;
  padding: 20rpx;
  background: #f8fbff;
  border: 2rpx solid #dbeafe;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.preview-box {
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  background: #f8fbff;
  border-radius: 20rpx;
  padding: 24rpx;
  border: 2rpx dashed #bfdbfe;
}

.grid-preview-wrap {
  position: relative;
  width: 100%;
  max-width: 600rpx;
  margin: 0 auto;
}

.grid-preview-img {
  width: 100%;
  height: 600rpx;
  border-radius: 16rpx;
  background: #e2e8f0;
}

.grid-lines {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
}

.grid-line-v,
.grid-line-h {
  position: absolute;
  background: rgba(37, 99, 235, 0.45);
}

.grid-line-v1 { left: 33.33%; top: 0; bottom: 0; width: 2rpx; }
.grid-line-v2 { left: 66.66%; top: 0; bottom: 0; width: 2rpx; }
.grid-line-h1 { top: 33.33%; left: 0; right: 0; height: 2rpx; }
.grid-line-h2 { top: 66.66%; left: 0; right: 0; height: 2rpx; }

.grid-result {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.grid-piece {
  width: calc(33.33% - 8rpx);
  box-sizing: border-box;
}

.grid-piece-img {
  width: 100%;
  height: 180rpx;
  border-radius: 12rpx;
  background: #f1f5f9;
}

.grid-piece-label {
  text-align: center;
  font-size: 22rpx;
  color: #64748b;
  margin-top: 6rpx;
}

.qr-canvas-wrap {
  width: 520rpx;
  height: 520rpx;
  margin: 0 auto;
}

.qr-canvas {
  width: 520rpx;
  height: 520rpx;
}

.hidden-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 1px;
  height: 1px;
}

.foot-note {
  margin-top: 24rpx;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 16rpx;
  border: 1rpx solid #dbeafe;
}

.foot-note-item {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.7;
}

.secondary-btn {
  margin-top: 16rpx;
  background: #e2e8f0;
  color: #334155;
  border-radius: 16rpx;
  font-size: 28rpx;
  border: none;
}

.explain-card {
  padding: 28rpx;
  background: rgba(255, 251, 235, 0.92);
  border-color: #fde68a;
}

.explain-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #92400e;
  margin-bottom: 16rpx;
}

.explain-item {
  font-size: 24rpx;
  color: #78350f;
  line-height: 1.7;
  margin-bottom: 12rpx;
}

.explain-item:last-of-type {
  margin-bottom: 0;
}

.explain-em {
  font-weight: 600;
  color: #b45309;
}

.explain-tip {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #1d4ed8;
  line-height: 1.6;
  border: 1rpx solid #bfdbfe;
}
